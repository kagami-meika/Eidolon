<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.2.2.0</Version>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <InformationalVersion>0.2.2.0</InformationalVersion>
    <Product>Eidolon</Product>
    <AssemblyTitle>Eidolon</AssemblyTitle>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eidolon.Core\Eidolon.Core.csproj" />
    <ProjectReference Include="..\Eidolon.Brush\Eidolon.Brush.csproj" />
    <ProjectReference Include="..\Eidolon.IO\Eidolon.IO.csproj" />
    <ProjectReference Include="..\Eidolon.Input\Eidolon.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>

  <!-- WithCulture=false: filenames like strings.en.json must NOT become satellite assemblies. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\strings.cn.json">
      <LogicalName>Eidolon.App.Resources.strings.cn.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\strings.en.json">
      <LogicalName>Eidolon.App.Resources.strings.en.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Bundle ffmpeg.exe if present in tools/ -->
  <ItemGroup Condition="Exists('..\..\tools\ffmpeg.exe')">
    <Content Include="..\..\tools\ffmpeg.exe" Link="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


</Project>
