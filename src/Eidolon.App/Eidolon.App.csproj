<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.1.0.1</AssemblyVersion>
    <FileVersion>0.1.0.1</FileVersion>
    <InformationalVersion>beta-01</InformationalVersion>
    <Product>Eidolon</Product>
    <AssemblyTitle>Eidolon</AssemblyTitle>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eidolon.Core\Eidolon.Core.csproj" />
    <ProjectReference Include="..\Eidolon.Brush\Eidolon.Brush.csproj" />
    <ProjectReference Include="..\Eidolon.IO\Eidolon.IO.csproj" />
    <ProjectReference Include="..\Eidolon.Input\Eidolon.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\strings.cn.json" />
    <EmbeddedResource Include="Resources\strings.en.json" />
  </ItemGroup>

  <!-- Bundle ffmpeg.exe if present in tools/ -->
  <ItemGroup Condition="Exists('..\..\tools\ffmpeg.exe')">
    <Content Include="..\..\tools\ffmpeg.exe" Link="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


</Project>
